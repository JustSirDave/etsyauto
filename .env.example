# Database
DB_PASSWORD=postgres_secure_password_change_me
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@db:5432/etsy_platform

# Production URL (change for deployment)
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:3000"]

# JWT Keys (generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_change_me
NEXTAUTH_URL=http://localhost:3000

# Etsy API (get from https://www.etsy.com/developers/your-apps)
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=http://localhost:3000/api/auth/callback/etsy

# AI Providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Printful API (optional for Phase 1)
PRINTFUL_API_KEY=

# Monitoring
SENTRY_DSN=
GRAFANA_PASSWORD=admin

# Feature Flags
ENABLE_PRINTFUL_SYNC=false
ENABLE_SCHEDULED_PUBLISHING=true
ENABLE_AI_GENERATION=true

# Rate Limiting (per shop)
ETSY_RATE_LIMIT_CAPACITY=100
ETSY_RATE_LIMIT_REFILL_PER_SEC=0.5

# AI Configuration
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# Storage (optional - for images)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
